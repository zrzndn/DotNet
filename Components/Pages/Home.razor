@code {
    private string searchTerm = "";
    private string newTicketTitle = "";
    private string newTicketCategory = "Hardware";
    private string newTicketPriority = "Medium";
    private string feedback = "";
    private bool isError = false;
private int? editingTicketId;
private int? deleteConfirmationId;

private string editTitle = "";
private string editCategory = "Hardware";
private string editPriority = "Medium";

    private List<SupportTicket> tickets = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            // Insert demo records only when the database is empty.
            if (!await db.SupportTickets.AnyAsync())
            {
                db.SupportTickets.AddRange(
                    new SupportTicket
                    {
                        Title = "VPN connection failing",
                        Category = "Network",
                        Priority = "High",
                        Status = "Open",
                        CreatedAtUtc = DateTime.UtcNow.AddHours(-5)
                    },
                    new SupportTicket
                    {
                        Title = "Install development tools",
                        Category = "Software",
                        Priority = "Medium",
                        Status = "In Progress",
                        CreatedAtUtc = DateTime.UtcNow.AddHours(-3)
                    },
                    new SupportTicket
                    {
                        Title = "Reset account access",
                        Category = "Access and Accounts",
                        Priority = "Low",
                        Status = "Resolved",
                        CreatedAtUtc = DateTime.UtcNow.AddHours(-1)
                    }
                );

                await db.SaveChangesAsync();
            }

            tickets = await db.SupportTickets
                .OrderByDescending(t => t.CreatedAtUtc)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Could not load tickets: {ex}");

            feedback = "Could not load tickets. Check the application logs.";
            isError = true;
        }
    }

    private IEnumerable<SupportTicket> FilteredTickets =>
        tickets.Where(ticket =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            ticket.Title.Contains(
                searchTerm,
                StringComparison.OrdinalIgnoreCase) ||
            ticket.Id.ToString().Contains(
                searchTerm,
                StringComparison.OrdinalIgnoreCase));

    private async Task CreateTicket()
    {
        feedback = "";
        isError = false;

        var title = newTicketTitle.Trim();

        if (string.IsNullOrWhiteSpace(title))
        {
            feedback = "Enter a ticket description.";
            isError = true;
            return;
        }

        if (title.Length > 200)
        {
            feedback = "Description cannot exceed 200 characters.";
            isError = true;
            return;
        }

        var allowedCategories = new[]
        {
            "Hardware",
            "Network",
            "Software",
            "Access and Accounts"
        };

        var allowedPriorities = new[]
        {
            "Low",
            "Medium",
            "High",
            "Critical"
        };

        if (!allowedCategories.Contains(newTicketCategory) ||
            !allowedPriorities.Contains(newTicketPriority))
        {
            feedback = "Choose a valid category and priority.";
            isError = true;
            return;
        }

        var ticket = new SupportTicket
        {
            Title = title,
            Category = newTicketCategory,
            Priority = newTicketPriority,
            Status = "Open",
            CreatedAtUtc = DateTime.UtcNow
        };

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            db.SupportTickets.Add(ticket);
            await db.SaveChangesAsync();

            // The database has now generated the ticket ID.
            tickets.Insert(0, ticket);
	    searchTerm = "";
            newTicketTitle = "";
            feedback = $"Ticket #{ticket.Id} saved successfully.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Could not save ticket: {ex}");

            feedback = "Could not save the ticket. Check the application logs.";
            isError = true;
        }
    }


private void BeginEdit(SupportTicket ticket)
{
    editingTicketId = ticket.Id;
    deleteConfirmationId = null;

    editTitle = ticket.Title;
    editCategory = ticket.Category;
    editPriority = ticket.Priority;

    feedback = "";
    isError = false;
}

private void CancelEdit()
{
    editingTicketId = null;
}

private void RequestDelete(int id)
{
    deleteConfirmationId = id;
    editingTicketId = null;
}

private void CancelDelete()
{
    deleteConfirmationId = null;
}

private async Task SaveEditAsync()
{
    if (editingTicketId is not int id)
        return;

    var title = editTitle.Trim();

    var categories = new[]
    {
        "Hardware", "Network", "Software", "Access and Accounts"
    };

    var priorities = new[]
    {
        "Low", "Medium", "High", "Critical"
    };

    if (string.IsNullOrWhiteSpace(title) || title.Length > 200)
    {
        feedback = "Title must contain 1–200 characters.";
        isError = true;
        return;
    }

    if (!categories.Contains(editCategory) ||
        !priorities.Contains(editPriority))
    {
        feedback = "Select a valid category and priority.";
        isError = true;
        return;
    }

    try
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var entity = await db.SupportTickets
            .FirstOrDefaultAsync(t => t.Id == id);

        if (entity is null)
        {
            tickets.RemoveAll(t => t.Id == id);
            editingTicketId = null;
            feedback = "Ticket not found.";
            isError = true;
            return;
        }

        entity.Title = title;
        entity.Category = editCategory;
        entity.Priority = editPriority;

        await db.SaveChangesAsync();

        var displayed = tickets.FirstOrDefault(t => t.Id == id);
        if (displayed is not null)
        {
            displayed.Title = title;
            displayed.Category = editCategory;
            displayed.Priority = editPriority;
        }

        editingTicketId = null;
        feedback = $"Ticket #{id} updated successfully.";
        isError = false;
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Ticket update failed: {ex}");
        feedback = "Unable to update the ticket. Check application logs.";
        isError = true;
    }
}

private async Task UpdateTicketStatusAsync(
    int id, ChangeEventArgs args)
{
    var status = args.Value?.ToString();

    var statuses = new[] { "Open", "In Progress", "Resolved" };

    if (status is null || !statuses.Contains(status))
    {
        feedback = "Invalid ticket status.";
        isError = true;
        return;
    }

    try
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var entity = await db.SupportTickets
            .FirstOrDefaultAsync(t => t.Id == id);

        if (entity is null)
        {
            tickets.RemoveAll(t => t.Id == id);
            feedback = "Ticket not found.";
            isError = true;
            return;
        }

        entity.Status = status;
        await db.SaveChangesAsync();

        var displayed = tickets.FirstOrDefault(t => t.Id == id);
        if (displayed is not null)
            displayed.Status = status;

        feedback = $"Ticket #{id} status changed to {status}.";
        isError = false;
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Status update failed: {ex}");
        feedback = "Unable to update status. Check application logs.";
        isError = true;
    }
}

private async Task DeleteTicketAsync(int id)
{
    try
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var entity = await db.SupportTickets
            .FirstOrDefaultAsync(t => t.Id == id);

        if (entity is null)
        {
            tickets.RemoveAll(t => t.Id == id);
            feedback = "Ticket no longer exists.";
            isError = true;
        }
        else
        {
            db.SupportTickets.Remove(entity);
            await db.SaveChangesAsync();

            tickets.RemoveAll(t => t.Id == id);
            feedback = $"Ticket #{id} deleted successfully.";
            isError = false;
        }

        if (editingTicketId == id)
            editingTicketId = null;

        deleteConfirmationId = null;
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Ticket deletion failed: {ex}");
        feedback = "Unable to delete the ticket. Check application logs.";
        isError = true;
    }
}


    private static string GetStatusClass(string status) => status switch
    {
        "Open" => "status-pill status-open",
        "In Progress" => "status-pill status-progress",
        _ => "status-pill status-resolved"
    };

    private static string GetPriorityClass(string priority) =>
        $"priority-pill priority-{priority.ToLowerInvariant()}";
}
