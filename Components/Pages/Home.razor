
@page "/"
@using Microsoft.EntityFrameworkCore
@using OpsHub.Data
@using OpsHub.Models
@inject IDbContextFactory<OpsHubDbContext> DbFactory

<PageTitle>OpsHub | Dashboard</PageTitle>

<div class="opshub">
    <header class="page-header">
        <div>
            <p class="eyebrow">IT OPERATIONS / OVERVIEW</p>
            <h1>Operations dashboard</h1>
            <p class="subtitle">Monitor assets, service requests and daily IT activity.</p>
        </div>
        <div class="header-tag">DEMO ENVIRONMENT</div>
    </header>

    <section class="stats-grid">
        <article class="stat-card">
            <p>Total assets</p>
            <h2>128</h2>
            <span>Registered equipment</span>
        </article>

        <article class="stat-card">
            <p>Open tickets</p>
            <h2>@tickets.Count(t => t.Status == "Open")</h2>
            <span>Awaiting resolution</span>
        </article>

        <article class="stat-card">
            <p>In progress</p>
            <h2>@tickets.Count(t => t.Status == "In Progress")</h2>
            <span>Being investigated</span>
        </article>

        <article class="stat-card">
            <p>Resolved</p>
            <h2>@tickets.Count(t => t.Status == "Resolved")</h2>
            <span>Completed requests</span>
        </article>
    </section>

    <section class="content-grid">
        <article class="panel">
            <div class="panel-heading">
                <div>
                    <h2>Helpdesk tickets</h2>
                    <p>Track and search service requests.</p>
                </div>
                <span class="count-badge">@FilteredTickets.Count()</span>
            </div>

            <input class="search-box"
                   placeholder="Search ticket title or ID..."
                   aria-label="Search tickets"
                   @bind="searchTerm"
                   @bind:event="oninput" />

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>Priority</th>
                            <th>Status</th>
        	            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                       
@foreach (var ticket in FilteredTickets)
{
    <tr @key="ticket.Id">
        <td>
            <strong>#@ticket.Id</strong>
            <div class="ticket-title">@ticket.Title</div>
            <span class="ticket-category">@ticket.Category</span>
        </td>

        <td>
            <span class="@GetPriorityClass(ticket.Priority)">
                @ticket.Priority
            </span>
        </td>

        <td>
            <select class="status-select"
                    value="@ticket.Status"
                    aria-label="Change ticket status"
                    @onchange="(ChangeEventArgs e) => UpdateTicketStatusAsync(ticket.Id, e)">
                <option value="Open">Open</option>
                <option value="In Progress">In Progress</option>
                <option value="Resolved">Resolved</option>
            </select>
        </td>

        <td>
            <div class="action-buttons">
                <button type="button"
                        class="secondary-button"
                        @onclick="() => BeginEdit(ticket)">
                    Edit
                </button>

                <button type="button"
                        class="danger-button"
                        @onclick="() => RequestDelete(ticket.Id)">
                    Delete
                </button>
            </div>

            @if (deleteConfirmationId == ticket.Id)
            {
                <div class="delete-confirm">
                    <p>Delete ticket #@ticket.Id?</p>

                    <button type="button"
                            class="danger-button"
                            @onclick="() => DeleteTicketAsync(ticket.Id)">
                        Confirm
                    </button>

                    <button type="button"
                            class="secondary-button"
                            @onclick="CancelDelete">
                        Cancel
                    </button>
                </div>
            }
        </td>
    </tr>

    @if (editingTicketId == ticket.Id)
    {
        <tr>
            <td colspan="4">
                <div class="edit-ticket-form">
                    <h3>Edit ticket #@ticket.Id</h3>

                    <label>Title</label>
                    <input class="form-control"
                           @bind="editTitle"
                           maxlength="200" />

                    <label>Category</label>
                    <select class="form-control" @bind="editCategory">
                        <option>Hardware</option>
                        <option>Network</option>
                        <option>Software</option>
                        <option>Access and Accounts</option>
                    </select>

                    <label>Priority</label>
                    <select class="form-control" @bind="editPriority">
                        <option>Low</option>
                        <option>Medium</option>
                        <option>High</option>
                        <option>Critical</option>
                    </select>

                    <button type="button"
                            class="primary-button"
                            @onclick="SaveEditAsync">
                        Save changes
                    </button>

                    <button type="button"
                            class="secondary-button"
                            @onclick="CancelEdit">
                        Cancel
                    </button>
                </div>
            </td>
        </tr>
    }
}

@if (!FilteredTickets.Any())
{
    <tr>
        <td colspan="4" class="empty-state">
            No matching tickets found.
        </td>
    </tr>
}

                    </tbody>
                </table>
            </div>
        </article>

        <article class="panel create-panel">
            <div class="panel-heading">
                <div>
                    <h2>Create a ticket</h2>
                    <p>Register a new IT support request.</p>
                </div>
            </div>

            <form @onsubmit="CreateTicket" @onsubmit:preventDefault="true">
                <label for="ticketTitle">Ticket description</label>
                <input id="ticketTitle"
                       class="form-control"
                       @bind="newTicketTitle"
                       placeholder="e.g. Laptop cannot connect to Wi-Fi"
                       required />

                <label for="ticketCategory">Category</label>
                <select id="ticketCategory"
                        class="form-control"
                        @bind="newTicketCategory">
                    <option>Hardware</option>
                    <option>Network</option>
                    <option>Software</option>
                    <option>Access and Accounts</option>
                </select>

                <label for="ticketPriority">Priority</label>
                <select id="ticketPriority"
                        class="form-control"
                        @bind="newTicketPriority">
                    <option>Low</option>
                    <option>Medium</option>
                    <option>High</option>
                    <option>Critical</option>
                </select>

                <button class="primary-button" type="submit">
                    + Create ticket
                </button>
            </form>

            @if (!string.IsNullOrEmpty(feedback))
            {
                <p class="@(isError ? "error-message" : "success-message")" role="status">
    @feedback
</p>
            }

            <p class="demo-note">
    Data is stored locally in SQLite and persists across restarts.
            </p>
        </article>
    </section>

    <footer class="page-footer">
        OpsHub · IT Operations Portal · Built with .NET 10 and Blazor
    </footer>
</div>

