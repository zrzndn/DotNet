
@page "/"

<PageTitle>OpsHub | Dashboard</PageTitle>

<div class="opshub">
    <header class="page-header">
        <div>
            <p class="eyebrow">IT OPERATIONS / OVERVIEW</p>
            <h1>Operations dashboard</h1>
            <p class="subtitle">Monitor assets, service requests and daily IT activity.</p>
        </div>
        <div class="header-tag">DEMO ENVIRONMENT</div>
    </header>

    <section class="stats-grid">
        <article class="stat-card">
            <p>Total assets</p>
            <h2>128</h2>
            <span>Registered equipment</span>
        </article>

        <article class="stat-card">
            <p>Open tickets</p>
            <h2>@tickets.Count(t => t.Status == "Open")</h2>
            <span>Awaiting resolution</span>
        </article>

        <article class="stat-card">
            <p>In progress</p>
            <h2>@tickets.Count(t => t.Status == "In Progress")</h2>
            <span>Being investigated</span>
        </article>

        <article class="stat-card">
            <p>Resolved</p>
            <h2>@tickets.Count(t => t.Status == "Resolved")</h2>
            <span>Completed requests</span>
        </article>
    </section>

    <section class="content-grid">
        <article class="panel">
            <div class="panel-heading">
                <div>
                    <h2>Helpdesk tickets</h2>
                    <p>Track and search service requests.</p>
                </div>
                <span class="count-badge">@FilteredTickets.Count()</span>
            </div>

            <input class="search-box"
                   placeholder="Search ticket title or ID..."
                   aria-label="Search tickets"
                   @bind="searchTerm"
                   @bind:event="oninput" />

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>Priority</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in FilteredTickets)
                        {
                            <tr @key="ticket.Id">
                                <td>
                                    <strong>#@ticket.Id</strong>
                                    <div class="ticket-title">@ticket.Title</div>
                                    <span class="ticket-category">@ticket.Category</span>
                                </td>
                                <td>
                                    <span class="@GetPriorityClass(ticket.Priority)">
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="@GetStatusClass(ticket.Status)">
                                        @ticket.Status
                                    </span>
                                </td>
                            </tr>
                        }

                        @if (!FilteredTickets.Any())
                        {
                            <tr>
                                <td colspan="3" class="empty-state">
                                    No matching tickets found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="panel create-panel">
            <div class="panel-heading">
                <div>
                    <h2>Create a ticket</h2>
                    <p>Register a new IT support request.</p>
                </div>
            </div>

            <form @onsubmit="CreateTicket" @onsubmit:preventDefault="true">
                <label for="ticketTitle">Ticket description</label>
                <input id="ticketTitle"
                       class="form-control"
                       @bind="newTicketTitle"
                       placeholder="e.g. Laptop cannot connect to Wi-Fi"
                       required />

                <label for="ticketCategory">Category</label>
                <select id="ticketCategory"
                        class="form-control"
                        @bind="newTicketCategory">
                    <option>Hardware</option>
                    <option>Network</option>
                    <option>Software</option>
                    <option>Access and Accounts</option>
                </select>

                <label for="ticketPriority">Priority</label>
                <select id="ticketPriority"
                        class="form-control"
                        @bind="newTicketPriority">
                    <option>Low</option>
                    <option>Medium</option>
                    <option>High</option>
                    <option>Critical</option>
                </select>

                <button class="primary-button" type="submit">
                    + Create ticket
                </button>
            </form>

            @if (!string.IsNullOrEmpty(feedback))
            {
                <p class="success-message" role="status">@feedback</p>
            }

            <p class="demo-note">
                Demo mode: tickets are stored in memory and reset when the app restarts.
            </p>
        </article>
    </section>

    <footer class="page-footer">
        OpsHub · IT Operations Portal · Built with .NET 10 and Blazor
    </footer>
</div>

<style>
    .opshub {
        color: #e8edf5;
        padding: 28px;
        max-width: 1500px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .eyebrow {
        color: #7ca7ff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .page-header h1 {
        font-size: clamp(26px, 4vw, 36px);
        margin: 0;
        font-weight: 750;
    }

    .subtitle, .panel-heading p {
        color: #9ba8ba;
        font-size: 14px;
        margin-top: 8px;
    }

    .header-tag, .count-badge {
        border: 1px solid #34445b;
        color: #9db9ff;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .stat-card, .panel {
        background: #151e2d;
        border: 1px solid #28364a;
        border-radius: 14px;
    }

    .stat-card {
        padding: 22px;
    }

    .stat-card p {
        color: #a9b6c9;
        font-size: 13px;
        margin: 0;
    }

    .stat-card h2 {
        font-size: 32px;
        margin: 15px 0 8px;
    }

    .stat-card span, .ticket-category, .demo-note {
        color: #8797ad;
        font-size: 12px;
    }

    .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr);
        gap: 20px;
    }

    .panel {
        padding: 22px;
        min-width: 0;
    }

    .panel-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

    .panel-heading h2 {
        font-size: 19px;
        margin: 0;
    }

    .panel-heading p {
        margin-bottom: 0;
    }

    .search-box, .form-control {
        box-sizing: border-box;
        width: 100%;
        background: #0e1623;
        color: #e8edf5;
        border: 1px solid #34445b;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 18px;
    }

    .search-box:focus, .form-control:focus {
        outline: 2px solid #6e9dff;
        outline-offset: 1px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 13px;
    }

    th {
        color: #91a1b7;
        font-weight: 600;
        padding: 12px 8px;
        border-bottom: 1px solid #34445b;
    }

    td {
        padding: 16px 8px;
        border-bottom: 1px solid #263247;
        vertical-align: top;
    }

    .ticket-title {
        margin: 6px 0;
        min-width: 110px;
    }

    .status-pill, .priority-pill {
        display: inline-block;
        border-radius: 20px;
        padding: 5px 9px;
        font-size: 11px;
        white-space: nowrap;
    }

    .status-open { background: #492f20; color: #ffc18e; }
    .status-progress { background: #1d365b; color: #a3c9ff; }
    .status-resolved { background: #183d34; color: #8de0be; }

    .priority-low { color: #a9b6c9; }
    .priority-medium { color: #f4d47a; }
    .priority-high { color: #ffad78; }
    .priority-critical { color: #ff9292; }

    .create-panel form {
        display: flex;
        flex-direction: column;
    }

    .create-panel label {
        font-size: 13px;
        margin-bottom: 8px;
        color: #cbd5e3;
    }

    .primary-button {
        border: 0;
        border-radius: 8px;
        background: #3976e8;
        color: white;
        font-weight: 700;
        padding: 13px 16px;
        cursor: pointer;
        margin-top: 4px;
    }

    .primary-button:hover {
        background: #2f65ca;
    }

    .success-message {
        color: #8de0be;
        font-size: 13px;
    }

    .demo-note {
        margin-top: 20px;
        line-height: 1.6;
    }

    .empty-state {
        color: #9ba8ba;
        text-align: center;
        padding: 28px 8px;
    }

    .page-footer {
        color: #78879c;
        font-size: 12px;
        padding: 24px 0 4px;
    }

    @@media (max-width: 850px) {
        .content-grid { grid-template-columns: 1fr; }
        .page-header { align-items: flex-start; flex-direction: column; }
        .opshub { padding: 16px; }
    }
</style>

@code {
    private string searchTerm = "";
    private string newTicketTitle = "";
    private string newTicketCategory = "Hardware";
    private string newTicketPriority = "Medium";
    private string feedback = "";
    private int nextTicketId = 104;

    private List<SupportTicket> tickets = new()
    {
        new(103, "VPN connection failing", "Network", "High", "Open"),
        new(102, "Install approved development tools", "Software", "Medium", "In Progress"),
        new(101, "Reset account access", "Access and Accounts", "Low", "Resolved")
    };

    private IEnumerable<SupportTicket> FilteredTickets =>
        tickets.Where(ticket =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            ticket.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            ticket.Id.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private void CreateTicket()
    {
        if (string.IsNullOrWhiteSpace(newTicketTitle))
        {
            feedback = "Enter a description first.";
            return;
        }

        tickets.Insert(0, new SupportTicket(
            nextTicketId++,
            newTicketTitle.Trim(),
            newTicketCategory,
            newTicketPriority,
            "Open"));

        newTicketTitle = "";
        feedback = "Ticket created successfully.";
    }

    private static string GetStatusClass(string status) => status switch
    {
        "Open" => "status-pill status-open",
        "In Progress" => "status-pill status-progress",
        _ => "status-pill status-resolved"
    };

    private static string GetPriorityClass(string priority) =>
        $"priority-pill priority-{priority.ToLowerInvariant()}";

    private record SupportTicket(
        int Id,
        string Title,
        string Category,
        string Priority,
        string Status);
}
