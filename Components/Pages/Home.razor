@code {
    private static readonly string[] Statuses = ["Open", "In Progress", "Resolved"];
    private static readonly string[] Priorities = ["Critical", "High", "Medium", "Low"];
    private static readonly string[] Categories =
        ["Hardware", "Network", "Software", "Access and Accounts"];

    private List<SupportTicket> tickets = [];
    private SupportTicket formTicket = CreateEmptyTicket();
    private string searchTerm = "";
    private string selectedStatus = "";
    private string selectedCategory = "";
    private string selectedPriority = "";
    private string sortOrder = "newest";
    private string feedback = "";
    private string formError = "";
    private bool isError;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isReportLoading;
    private string reportError = "";
    private TicketReport? report;
    private DateOnly? reportFrom;
    private DateOnly? reportTo;
    private bool isSaving;
    private bool showTicketForm;
    private bool showArchivedTickets;
    private bool scrollToTicketForm;
    private int? editingTicketId;
    private int? deleteConfirmationId;
    private string ExportUrl
    {
        get
        {
            var query = new List<string>();
            if (reportFrom is DateOnly from)
                query.Add($"from={from:yyyy-MM-dd}");
            if (reportTo is DateOnly to)
                query.Add($"to={to:yyyy-MM-dd}");
            return "/reports/tickets.csv" +
                   (query.Count == 0 ? "" : $"?{string.Join("&", query)}");
        }
    }

    [SupplyParameterFromQuery(Name = "edit")]
    public int? EditTicketQuery { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private IEnumerable<SupportTicket> FilteredTickets
    {
        get
        {
            var filtered = tickets.Where(ticket =>
                (string.IsNullOrWhiteSpace(searchTerm) ||
                 ticket.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                 ticket.Requester.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                 ticket.Id.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(selectedStatus) || ticket.Status == selectedStatus) &&
                (string.IsNullOrWhiteSpace(selectedCategory) || ticket.Category == selectedCategory) &&
                (string.IsNullOrWhiteSpace(selectedPriority) || ticket.Priority == selectedPriority));

            return sortOrder switch
            {
                "oldest" => filtered.OrderBy(ticket => ticket.CreatedAtUtc),
                "priority" => filtered.OrderBy(ticket => Array.IndexOf(Priorities, ticket.Priority))
                    .ThenByDescending(ticket => ticket.CreatedAtUtc),
                "status" => filtered.OrderBy(ticket => Array.IndexOf(Statuses, ticket.Status))
                    .ThenByDescending(ticket => ticket.CreatedAtUtc),
                _ => filtered.OrderByDescending(ticket => ticket.CreatedAtUtc)
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToTicketForm)
            return;

        scrollToTicketForm = false;
        await JS.InvokeVoidAsync("opshub.scrollToElement", "ticket-form");
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        !string.IsNullOrWhiteSpace(selectedStatus) ||
        !string.IsNullOrWhiteSpace(selectedCategory) ||
        !string.IsNullOrWhiteSpace(selectedPriority);

    private int UnresolvedCount => tickets.Count(ticket => ticket.Status != "Resolved");
    private int UrgentOpenCount => tickets.Count(ticket =>
        ticket.Status != "Resolved" && ticket.Priority is "Critical" or "High");
    private int OverdueCount => tickets.Count(IsOverdue);

    protected override async Task OnParametersSetAsync()
    {
        await LoadTicketsAsync();
        if (EditTicketQuery is int id)
        {
            var principal = (await AuthenticationStateTask).User;
            if ((principal.IsInRole("Admin") || principal.IsInRole("Agent")) &&
                tickets.FirstOrDefault(ticket => ticket.Id == id) is { } ticket)
            {
                BeginEdit(ticket);
                scrollToTicketForm = true;
            }

            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task LoadTicketsAsync()
    {
        isLoading = true;
        loadFailed = false;
        try
        {
            tickets = (await TicketsService.GetAllAsync(showArchivedTickets)).ToList();
            await LoadReportAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not load tickets: {ex}");
            feedback = "Could not load tickets. Check the application logs.";
            isError = true;
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadReportAsync()
    {
        isReportLoading = true;
        reportError = "";
        try
        {
            var fromUtc = reportFrom?.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
            DateTime? throughUtcExclusive = reportTo is not DateOnly through
                ? null
                : through == DateOnly.MaxValue
                    ? DateTime.MaxValue
                    : through.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
            report = await TicketsService.GetReportAsync(fromUtc, throughUtcExclusive);
        }
        catch (ArgumentException ex)
        {
            reportError = ex.Message;
            report = null;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not load ticket report: {ex}");
            reportError = "Could not load the report. Check the application logs.";
            report = null;
        }
        finally
        {
            isReportLoading = false;
        }
    }

    private async Task StartCreate()
    {
        editingTicketId = null;
        formTicket = CreateEmptyTicket();
        formTicket.Requester = (await AuthenticationStateTask).User.Identity?.Name ?? "";
        formError = "";
        showTicketForm = true;
        scrollToTicketForm = true;
    }

    private void BeginEdit(SupportTicket ticket)
    {
        editingTicketId = ticket.Id;
        formTicket = new SupportTicket
        {
            Title = ticket.Title,
            Description = ticket.Description,
            Category = ticket.Category,
            Requester = ticket.Requester,
            AssignedTechnician = ticket.AssignedTechnician,
            Priority = ticket.Priority,
            Status = ticket.Status,
            DueAtUtc = ticket.DueAtUtc,
            ResolutionNotes = ticket.ResolutionNotes
        };
        formError = "";
        showTicketForm = true;
    }

    private void CancelForm()
    {
        showTicketForm = false;
        editingTicketId = null;
        formError = "";
    }

    private async Task SaveTicketAsync()
    {
        if (isSaving)
            return;

        isSaving = true;
        formError = "";
        try
        {
            if (editingTicketId is int id)
            {
                await TicketsService.UpdateAsync(id, formTicket);
                feedback = $"Ticket #{id} updated successfully.";
            }
            else
            {
                var created = await TicketsService.CreateAsync(formTicket);
                feedback = $"Ticket #{created.Id} created successfully.";
            }

            isError = false;
            CancelForm();
            await LoadTicketsAsync();
            ClearFilters();
        }
        catch (ArgumentException ex)
        {
            formError = ex.Message;
        }
        catch (KeyNotFoundException ex)
        {
            formError = ex.Message;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not save ticket: {ex}");
            formError = "Could not save the ticket. Check the application logs.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UpdateStatusAsync(int id, ChangeEventArgs args)
    {
        var status = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(status))
            return;

        try
        {
            await TicketsService.UpdateStatusAsync(id, status);
            feedback = $"Ticket #{id} moved to {status}.";
            isError = false;
            await LoadTicketsAsync();
        }
        catch (ArgumentException ex)
        {
            feedback = ex.Message;
            isError = true;
            await LoadTicketsAsync();
        }
        catch (KeyNotFoundException ex)
        {
            feedback = ex.Message;
            isError = true;
            await LoadTicketsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not update ticket status: {ex}");
            feedback = "Could not update the ticket status. Check the application logs.";
            isError = true;
            await LoadTicketsAsync();
        }
    }

    private void RequestDelete(int id)
    {
        deleteConfirmationId = id;
        feedback = "";
    }

    private void CancelDelete() => deleteConfirmationId = null;

    private async Task ArchiveTicketAsync(int id)
    {
        try
        {
            await TicketsService.ArchiveAsync(id);
            tickets.RemoveAll(ticket => ticket.Id == id);
            deleteConfirmationId = null;
            feedback = $"Ticket #{id} archived. Its comments and history have been retained.";
            isError = false;
        }
        catch (KeyNotFoundException ex)
        {
            deleteConfirmationId = null;
            feedback = ex.Message;
            isError = true;
            await LoadTicketsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not delete ticket: {ex}");
            feedback = "Could not delete the ticket. Check the application logs.";
            isError = true;
        }
    }

    private void ClearFilters()
    {
        searchTerm = "";
        selectedStatus = "";
        selectedCategory = "";
        selectedPriority = "";
        sortOrder = "newest";
    }

    private int CountStatus(string status) => tickets.Count(ticket => ticket.Status == status);
    private int GetPercentage(int count) =>
        tickets.Count == 0 ? 0 : (int)Math.Round(count * 100d / tickets.Count);
    private int GetUnresolvedPercentage(int count) =>
        UnresolvedCount == 0 ? 0 : (int)Math.Round(count * 100d / UnresolvedCount);
    private SlaAssessment GetSlaAssessment(SupportTicket ticket) =>
        SlaCalculator.Assess(ticket, DateTime.UtcNow);
    private string GetSlaLabel(SupportTicket ticket)
    {
        var assessment = GetSlaAssessment(ticket);
        return assessment.State switch
        {
            SlaState.OnTrack => $"{FormatRemaining(assessment.Remaining)} remaining",
            SlaState.AtRisk => $"At risk · {FormatRemaining(assessment.Remaining)}",
            SlaState.Breached => "SLA breached",
            SlaState.Met => "SLA met",
            _ => "Not tracked"
        };
    }

    private string GetSlaClass(SupportTicket ticket) =>
        "sla-label " + (GetSlaAssessment(ticket).State switch
        {
            SlaState.AtRisk => "sla-at-risk",
            SlaState.Breached => "sla-breached",
            SlaState.Met => "sla-met",
            _ => ""
        });

    private static string FormatRemaining(TimeSpan? remaining)
    {
        if (remaining is null || remaining <= TimeSpan.Zero)
            return "0h";
        var value = remaining.Value;
        return value.TotalDays >= 1
            ? $"{(int)value.TotalDays}d {value.Hours}h"
            : $"{(int)value.TotalHours}h {value.Minutes}m";
    }

    private static string FormatDuration(TimeSpan? value) =>
        value is null
            ? "No resolved data"
            : value.Value.TotalDays >= 1
                ? $"{(int)value.Value.TotalDays}d {value.Value.Hours}h"
                : $"{(int)value.Value.TotalHours}h {value.Value.Minutes}m";

    private static string FormatPercent(double? value) =>
        value is null ? "No SLA data" : $"{value.Value:0.0}%";

    private static RenderFragment ReportBreakdown(
        string title,
        IReadOnlyList<TicketBreakdown> breakdown) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "report-breakdown");
        builder.OpenElement(sequence++, "h3");
        builder.AddContent(sequence++, title);
        builder.CloseElement();
        builder.OpenElement(sequence++, "ul");
        foreach (var item in breakdown)
        {
            builder.OpenElement(sequence++, "li");
            builder.AddContent(sequence++, item.Name);
            builder.OpenElement(sequence++, "strong");
            builder.AddContent(sequence++, item.Count);
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
    };
    private static bool IsOverdue(SupportTicket ticket) =>
        ticket.Status != "Resolved" &&
        ticket.DueAtUtc is DateTime due &&
        due.Date < DateTime.UtcNow.Date;

    private static string GetStatusClass(string status) => status switch
    {
        "Open" => "badge status-open",
        "In Progress" => "badge status-progress",
        "Resolved" => "badge status-resolved",
        _ => "badge"
    };

    private static string GetStatusBarClass(string status) => status switch
    {
        "Open" => "bar-open",
        "In Progress" => "bar-progress",
        "Resolved" => "bar-resolved",
        _ => ""
    };

    private static string GetPriorityClass(string priority) => priority switch
    {
        "Critical" => "badge priority-critical",
        "High" => "badge priority-high",
        "Medium" => "badge priority-medium",
        "Low" => "badge priority-low",
        _ => "badge"
    };

    private static string GetPriorityBarClass(string priority) => priority switch
    {
        "Critical" => "bar-critical",
        "High" => "bar-high",
        "Medium" => "bar-medium",
        "Low" => "bar-low",
        _ => ""
    };

    private static SupportTicket CreateEmptyTicket() => new()
    {
        Category = "Hardware",
        Priority = "Medium",
        Status = "Open"
    };
}
