@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using OpsHub.Models
@using OpsHub.Services
@inject TicketService TicketsService
@inject SlaCalculator SlaCalculator
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>OpsHub | Service desk</PageTitle>

<div class="dashboard">
    <header class="page-header">
        <div>
            <p class="eyebrow">SERVICE OPERATIONS</p>
            <h1>Service desk</h1>
            <p class="subtitle">A clear view of your team's support workload.</p>
        </div>
        <button class="button button-primary" type="button" @onclick="StartCreate">
            <span aria-hidden="true">+</span> New ticket
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <div class="notice @(isError ? "notice-error" : "notice-success")" role="status">
            @feedback
        </div>
    }

    @if (isLoading)
    {
        <section class="loading-state" aria-live="polite">
            <span class="loading-indicator" aria-hidden="true"></span>
            Loading service desk...
        </section>
    }
    else if (loadFailed)
    {
        <section class="empty-state">
            <h2>Tickets could not be loaded</h2>
            <p>Check the application logs and try again.</p>
            <button class="button button-secondary" @onclick="LoadTicketsAsync">Try again</button>
        </section>
    }
    else
    {
        <section class="metrics-grid" aria-label="Ticket overview">
            <article class="metric-card">
                <span class="metric-icon icon-total" aria-hidden="true">#</span>
                <p>Total tickets</p>
                <strong>@tickets.Count</strong>
                <span class="metric-caption">All service requests</span>
            </article>
            <article class="metric-card">
                <span class="metric-icon icon-open" aria-hidden="true">↗</span>
                <p>Open</p>
                <strong>@CountStatus("Open")</strong>
                <span class="metric-caption">Waiting for attention</span>
            </article>
            <article class="metric-card">
                <span class="metric-icon icon-progress" aria-hidden="true">◷</span>
                <p>In progress</p>
                <strong>@CountStatus("In Progress")</strong>
                <span class="metric-caption">Being worked on</span>
            </article>
            <article class="metric-card">
                <span class="metric-icon icon-resolved" aria-hidden="true">✓</span>
                <p>Resolved</p>
                <strong>@CountStatus("Resolved")</strong>
                <span class="metric-caption">Successfully completed</span>
            </article>
            <article class="metric-card metric-alert">
                <span class="metric-icon icon-critical" aria-hidden="true">!</span>
                <p>High priority</p>
                <strong>@UrgentOpenCount</strong>
                <span class="metric-caption">Critical or high, unresolved</span>
            </article>
            <article class="metric-card @(OverdueCount > 0 ? "metric-alert" : "")">
                <span class="metric-icon icon-overdue" aria-hidden="true">⌛</span>
                <p>Overdue</p>
                <strong>@OverdueCount</strong>
                <span class="metric-caption">Past due and unresolved</span>
            </article>
        </section>

        <section class="panel report-panel" aria-labelledby="report-heading">
            <div class="panel-heading report-heading">
                <div>
                    <p class="eyebrow">SERVICE PERFORMANCE</p>
                    <h2 id="report-heading">Ticket reporting</h2>
                    <p>Reports include active tickets created in the selected UTC date range.</p>
                </div>
                <a class="button button-secondary export-button" href="@ExportUrl">Export CSV</a>
            </div>
            <div class="report-filters">
                <label>
                    From date
                    <input type="date" class="form-control filter-select" @bind="reportFrom" />
                </label>
                <label>
                    Through date
                    <input type="date" class="form-control filter-select" @bind="reportTo" />
                </label>
                <button class="button button-secondary" type="button"
                        @onclick="LoadReportAsync" disabled="@isReportLoading">
                    @(isReportLoading ? "Refreshing..." : "Apply date range")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(reportError))
            {
                <p class="report-error" role="alert">@reportError</p>
            }
            else if (isReportLoading)
            {
                <p class="report-empty">Loading report...</p>
            }
            else if (report is { HasData: false })
            {
                <p class="report-empty">No tickets were created in this date range.</p>
            }
            else if (report is not null)
            {
                <div class="report-metrics">
                    <div><span>Volume</span><strong>@report.TotalTickets</strong></div>
                    <div><span>Resolution rate</span><strong>@($"{report.ResolutionRatePercent:0.0}%")</strong></div>
                    <div><span>Average resolution</span><strong>@FormatDuration(report.AverageResolutionTime)</strong></div>
                    <div><span>SLA compliance</span><strong>@FormatPercent(report.SlaCompliancePercent)</strong></div>
                </div>
                <div class="report-breakdowns">
                    @ReportBreakdown("By priority", report.ByPriority)
                    @ReportBreakdown("By status", report.ByStatus)
                    @ReportBreakdown("By category", report.ByCategory)
                    @ReportBreakdown("By assigned technician", report.ByTechnician)
                </div>
            }
        </section>

        <section class="overview-grid">
            <article class="panel summary-panel">
                <div class="panel-heading">
                    <div>
                        <h2>Ticket status</h2>
                        <p>Current workload breakdown</p>
                    </div>
                </div>
                @foreach (var status in Statuses)
                {
                    var count = CountStatus(status);
                    <div class="summary-row">
                        <div class="summary-label">
                            <span class="@GetStatusClass(status)">@status</span>
                            <strong>@count</strong>
                        </div>
                        <div class="summary-track" role="progressbar"
                             aria-label="@($"{status} tickets")"
                             aria-valuenow="@count" aria-valuemin="0"
                             aria-valuemax="@Math.Max(tickets.Count, 1)">
                            <span class="@GetStatusBarClass(status)"
                                  style="@($"width: {GetPercentage(count)}%")"></span>
                        </div>
                    </div>
                }
            </article>

            <article class="panel summary-panel">
                <div class="panel-heading">
                    <div>
                        <h2>Priority mix</h2>
                        <p>Unresolved requests by priority</p>
                    </div>
                </div>
                @foreach (var priority in Priorities)
                {
                    var count = tickets.Count(ticket =>
                        ticket.Priority == priority && ticket.Status != "Resolved");
                    <div class="summary-row">
                        <div class="summary-label">
                            <span class="@GetPriorityClass(priority)">@priority</span>
                            <strong>@count</strong>
                        </div>
                        <div class="summary-track" role="progressbar"
                             aria-label="@($"{priority} priority tickets")"
                             aria-valuenow="@count" aria-valuemin="0"
                             aria-valuemax="@Math.Max(UnresolvedCount, 1)">
                            <span class="@GetPriorityBarClass(priority)"
                                  style="@($"width: {GetUnresolvedPercentage(count)}%")"></span>
                        </div>
                    </div>
                }
            </article>
        </section>

        @if (showTicketForm)
        {
            <section class="panel ticket-form-panel" id="ticket-form">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">TICKET DETAILS</p>
                        <h2>@(editingTicketId.HasValue ? $"Edit ticket #{editingTicketId}" : "Create a ticket")</h2>
                    </div>
                    <button class="icon-button" type="button" aria-label="Close form"
                            @onclick="CancelForm">×</button>
                </div>
                <EditForm Model="formTicket" OnValidSubmit="SaveTicketAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="form-grid">
                        <div class="field field-wide">
                            <label for="ticket-title">Title <span aria-hidden="true">*</span></label>
                            <InputText id="ticket-title" class="form-control"
                                       @bind-Value="formTicket.Title" maxlength="200"
                                       placeholder="Briefly summarize the issue" />
                            <ValidationMessage For="@(() => formTicket.Title)" />
                        </div>
                        <div class="field field-wide">
                            <label for="ticket-description">Description <span aria-hidden="true">*</span></label>
                            <InputTextArea id="ticket-description" class="form-control textarea"
                                           @bind-Value="formTicket.Description" maxlength="2000"
                                           rows="4" placeholder="Describe the issue and any troubleshooting completed" />
                            <ValidationMessage For="@(() => formTicket.Description)" />
                        </div>
                        <div class="field">
                            <label for="ticket-requester">Requester <span aria-hidden="true">*</span></label>
                            <AuthorizeView Roles="Admin,Agent">
                                <Authorized Context="authState">
                                    <InputText id="ticket-requester" class="form-control"
                                               @bind-Value="formTicket.Requester" maxlength="150"
                                               placeholder="Name of the person requesting support" />
                                    <ValidationMessage For="@(() => formTicket.Requester)" />
                                </Authorized>
                                <NotAuthorized Context="authState">
                                    <p class="identity-derived">Set from your signed-in account.</p>
                                </NotAuthorized>
                            </AuthorizeView>
                        </div>
                        <div class="field">
                            <AuthorizeView Roles="Admin,Agent">
                                <Authorized Context="authState">
                                    <label for="ticket-assignee">Assigned technician</label>
                                    <InputText id="ticket-assignee" class="form-control"
                                               @bind-Value="formTicket.AssignedTechnician" maxlength="150"
                                               placeholder="Unassigned" />
                                    <ValidationMessage For="@(() => formTicket.AssignedTechnician)" />
                                </Authorized>
                            </AuthorizeView>
                        </div>
                        <div class="field">
                            <label for="ticket-category">Category</label>
                            <InputSelect id="ticket-category" class="form-control"
                                         @bind-Value="formTicket.Category">
                                @foreach (var category in Categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="field">
                            <label for="ticket-priority">Priority</label>
                            <InputSelect id="ticket-priority" class="form-control"
                                         @bind-Value="formTicket.Priority">
                                @foreach (var priority in Priorities)
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="field">
                            <label for="ticket-status">Status</label>
                            <AuthorizeView Roles="Admin,Agent">
                                <Authorized Context="authState">
                                    <InputSelect id="ticket-status" class="form-control"
                                                 @bind-Value="formTicket.Status">
                                        @foreach (var status in Statuses)
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    </InputSelect>
                                </Authorized>
                                <NotAuthorized Context="authState">
                                    <p class="identity-derived">New requests start as Open.</p>
                                </NotAuthorized>
                            </AuthorizeView>
                        </div>
                        <div class="field">
                            <label for="ticket-due">Due date</label>
                            <InputDate id="ticket-due" class="form-control"
                                       Type="InputDateType.Date"
                                       @bind-Value="formTicket.DueAtUtc" />
                        </div>
                        @if (formTicket.Status == "Resolved")
                        {
                            <div class="field field-wide">
                                <label for="resolution-notes">Resolution notes</label>
                                <InputTextArea id="resolution-notes" class="form-control textarea"
                                               @bind-Value="formTicket.ResolutionNotes"
                                               maxlength="2000" rows="3" />
                                <ValidationMessage For="@(() => formTicket.ResolutionNotes)" />
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <p class="notice notice-error" role="alert">@formError</p>
                    }
                    <div class="form-actions">
                        <button class="button button-primary" type="submit" disabled="@isSaving">
                            @(isSaving ? "Saving..." : editingTicketId.HasValue ? "Save changes" : "Create ticket")
                        </button>
                        <button class="button button-secondary" type="button" @onclick="CancelForm">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            </section>
        }

        <section class="panel tickets-panel" id="ticket-list">
            <div class="panel-heading tickets-heading">
                <div>
                    <p class="eyebrow">WORK QUEUE</p>
                    <h2>Recent tickets</h2>
                    <p>Search, filter, and manage service requests.</p>
                </div>
                <span class="count-badge">@FilteredTickets.Count() of @tickets.Count</span>
            </div>

            <AuthorizeView Roles="Admin">
                <Authorized Context="authState">
                    <label class="archived-filter">
                        <input type="checkbox" @bind="showArchivedTickets"
                               @bind:after="LoadTicketsAsync" />
                        Include archived tickets
                    </label>
                </Authorized>
            </AuthorizeView>

            <div class="filters">
                <label class="search-field">
                    <span class="visually-hidden">Search tickets</span>
                    <span aria-hidden="true">⌕</span>
                    <input type="search" placeholder="Search ID, title or requester"
                           @bind="searchTerm" @bind:event="oninput" />
                </label>
                <select class="form-control filter-select" aria-label="Filter by status"
                        @bind="selectedStatus">
                    <option value="">All statuses</option>
                    @foreach (var status in Statuses)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
                <select class="form-control filter-select" aria-label="Filter by category"
                        @bind="selectedCategory">
                    <option value="">All categories</option>
                    @foreach (var category in Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
                <select class="form-control filter-select" aria-label="Filter by priority"
                        @bind="selectedPriority">
                    <option value="">All priorities</option>
                    @foreach (var priority in Priorities)
                    {
                        <option value="@priority">@priority</option>
                    }
                </select>
                <select class="form-control filter-select sort-select" aria-label="Sort tickets"
                        @bind="sortOrder">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="priority">Priority</option>
                    <option value="status">Status</option>
                </select>
                @if (HasActiveFilters)
                {
                    <button class="button button-secondary clear-button" type="button"
                            @onclick="ClearFilters">Clear filters</button>
                }
            </div>

            @if (!FilteredTickets.Any())
            {
                <div class="empty-state">
                    <h3>@(tickets.Count == 0 ? "No tickets yet" : "No matching tickets")</h3>
                    <p>@(tickets.Count == 0
                        ? "Create a ticket to start tracking service requests."
                        : "Try changing the search term or filters.")</p>
                    @if (tickets.Count == 0)
                    {
                        <button class="button button-primary" @onclick="StartCreate">Create a ticket</button>
                    }
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Ticket</th>
                                <th scope="col">Requester</th>
                                <th scope="col">Updated</th>
                                <th scope="col">Due</th>
                                <th scope="col">SLA</th>
                                <th scope="col">Priority</th>
                                <th scope="col">Status</th>
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in FilteredTickets)
                            {
                                <tr @key="ticket.Id">
                                    <td>
                                        <a class="ticket-link" href="@($"/tickets/{ticket.Id}")">#@ticket.Id · @ticket.Title</a>
                                        <span class="ticket-subtitle">
                                            @ticket.Category
                                            @if (ticket.IsArchived)
                                            {
                                                <span class="archived-badge">Archived</span>
                                            }
                                        </span>
                                    </td>
                                    <td>@ticket.Requester</td>
                                    <td>@((ticket.UpdatedAtUtc ?? ticket.CreatedAtUtc).ToLocalTime().ToString("MMM d, yyyy"))</td>
                                    <td>
                                        @if (ticket.DueAtUtc is DateTime dueDate)
                                        {
                                            <span class="@(IsOverdue(ticket) ? "overdue-label" : "")">
                                                @dueDate.ToString("MMM d, yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="muted">No due date</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="@GetSlaClass(ticket)">
                                            @GetSlaLabel(ticket)
                                        </span>
                                    </td>
                                    <td><span class="@GetPriorityClass(ticket.Priority)">@ticket.Priority</span></td>
                                    <td>
                                        @if (ticket.IsArchived)
                                        {
                                            <span class="badge status-archived">Archived</span>
                                        }
                                        else
                                        {
                                            <AuthorizeView Roles="Admin,Agent">
                                                <Authorized Context="authState">
                                                    <select class="status-select @GetStatusClass(ticket.Status)"
                                                            value="@ticket.Status"
                                                            aria-label="@($"Status for ticket {ticket.Id}")"
                                                            @onchange="args => UpdateStatusAsync(ticket.Id, args)">
                                                        @foreach (var status in Statuses)
                                                        {
                                                            <option value="@status">@status</option>
                                                        }
                                                    </select>
                                                </Authorized>
                                                <NotAuthorized Context="authState">
                                                    <span class="@GetStatusClass(ticket.Status)">@ticket.Status</span>
                                                </NotAuthorized>
                                            </AuthorizeView>
                                        }
                                    </td>
                                    <td>
                                        <div class="row-actions">
                                            @if (!ticket.IsArchived)
                                            {
                                                <AuthorizeView Roles="Admin,Agent">
                                                    <Authorized Context="authState">
                                                        <button class="text-button" type="button"
                                                                @onclick="() => BeginEdit(ticket)">Edit</button>
                                                    </Authorized>
                                                </AuthorizeView>
                                                <AuthorizeView Roles="Admin">
                                                    <Authorized Context="authState">
                                                        <button class="text-button text-danger" type="button"
                                                                @onclick="() => RequestDelete(ticket.Id)">Archive</button>
                                                    </Authorized>
                                                </AuthorizeView>
                                            }
                                        </div>
                                        @if (deleteConfirmationId == ticket.Id)
                                        {
                                            <div class="delete-confirm" role="group"
                                                 aria-label="@($"Confirm archiving of ticket {ticket.Id}")">
                                                <span>Archive and retain its history?</span>
                                                <button class="text-button text-danger" type="button"
                                                        @onclick="() => ArchiveTicketAsync(ticket.Id)">Confirm</button>
                                                <button class="text-button" type="button"
                                                        @onclick="CancelDelete">Cancel</button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <footer class="page-footer">OpsHub Service Desk <span>·</span> Internal service operations</footer>
</div>

<style>
    .dashboard {
        --surface: #fff;
        --page: #f5f7fb;
        --ink: #17243a;
        --muted: #738198;
        --line: #e7ebf2;
        --blue: #3867d6;
        max-width: 1540px;
        margin: 0 auto;
        padding: 34px clamp(18px, 3vw, 42px);
        color: var(--ink);
    }

    .page-header, .panel-heading, .summary-label, .form-actions, .row-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }
    .page-header { margin-bottom: 26px; }
    .page-header h1 { margin: 0; font-size: clamp(28px, 3vw, 36px); letter-spacing: -.7px; }
    .eyebrow { margin: 0 0 7px; color: #647796; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; }
    .subtitle, .panel-heading p { margin: 7px 0 0; color: var(--muted); font-size: 13px; }
    .button { border: 1px solid transparent; border-radius: 8px; padding: 10px 15px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; transition: background .15s, border-color .15s; }
    .button:focus-visible, .icon-button:focus-visible, .text-button:focus-visible { outline: 3px solid #9bb9ff; outline-offset: 2px; }
    .button-primary { background: var(--blue); color: white; box-shadow: 0 3px 8px #3867d629; }
    .button-primary:hover:not(:disabled) { background: #2e57bc; }
    .button-primary:disabled { opacity: .65; cursor: wait; }
    .button-primary span { padding-right: 5px; font-size: 16px; }
    .button-secondary { border-color: #dce2eb; background: white; color: #45536b; }
    .button-secondary:hover { background: #f4f6fa; }
    .metrics-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 13px; margin-bottom: 16px; }
    .metric-card, .panel { border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: 0 2px 6px #14223a08; }
    .metric-card { position: relative; min-width: 0; padding: 18px; }
    .metric-card p { margin: 0 0 11px; color: var(--muted); font-size: 12px; }
    .metric-card strong { display: block; font-size: 30px; letter-spacing: -.6px; line-height: 1.05; }
    .metric-caption { display: block; margin-top: 9px; color: #91a0b4; font-size: 10px; }
    .metric-icon { display: grid; width: 29px; height: 29px; margin-bottom: 12px; place-items: center; border-radius: 8px; font-size: 14px; font-weight: 800; }
    .icon-total { background: #eef2ff; color: #556ed1; }
    .icon-open { background: #fff3e8; color: #c87625; }
    .icon-progress { background: #eaf3ff; color: #427ac6; }
    .icon-resolved { background: #e9f8f1; color: #32835f; }
    .icon-critical { background: #fff0ef; color: #c54b42; }
    .icon-overdue { background: #fff5e8; color: #ba7623; }
    .metric-alert strong { color: #b94a43; }
    .overview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .panel { min-width: 0; padding: 20px; }
    .panel-heading { margin-bottom: 18px; }
    .panel-heading h2 { margin: 0; font-size: 17px; letter-spacing: -.2px; }
    .summary-panel .panel-heading { margin-bottom: 20px; }
    .summary-row + .summary-row { margin-top: 15px; }
    .summary-label { margin-bottom: 7px; color: #64738a; font-size: 11px; }
    .summary-label strong { color: var(--ink); font-size: 12px; }
    .summary-track { height: 6px; overflow: hidden; border-radius: 8px; background: #eef1f6; }
    .summary-track span { display: block; height: 100%; min-width: 0; border-radius: inherit; transition: width .2s ease; }
    .bar-open { background: #e5a152; }
    .bar-progress { background: #5d8fe2; }
    .bar-resolved { background: #50aa7d; }
    .bar-critical { background: #cc5750; }
    .bar-high { background: #e9974b; }
    .bar-medium { background: #e0c35b; }
    .bar-low { background: #8d9aad; }
    .badge { display: inline-flex; align-items: center; border-radius: 20px; padding: 4px 8px; font-size: 10px; font-weight: 750; line-height: 1.2; white-space: nowrap; }
    .status-open { background: #fff2e5; color: #a4611b; }
    .status-progress { background: #e9f2ff; color: #3d6fab; }
    .status-resolved { background: #e8f7ef; color: #347b5a; }
    .priority-critical { background: #fff0ef; color: #b6423b; }
    .priority-high { background: #fff2e8; color: #a85b23; }
    .priority-medium { background: #fff8df; color: #876e1e; }
    .priority-low { background: #eff2f6; color: #657187; }
    .ticket-form-panel { margin-bottom: 16px; scroll-margin-top: 20px; }
    .report-panel { margin-bottom: 16px; }
    .report-heading { align-items: flex-start; }
    .report-heading h2 { margin: 0; color: var(--ink); font-size: 16px; }
    .report-heading p:last-child { margin: 6px 0 0; color: var(--muted); font-size: 11px; }
    .report-filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px; margin: 14px 0; }
    .report-filters label { display: grid; gap: 5px; color: #64738a; font-size: 10px; font-weight: 700; }
    .report-filters .form-control { min-width: 150px; }
    .report-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
    .report-metrics > div { display: grid; gap: 7px; border: 1px solid #edf0f5; border-radius: 8px; padding: 12px; }
    .report-metrics span { color: #7d8ba0; font-size: 10px; }
