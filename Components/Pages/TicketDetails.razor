@page "/tickets/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using OpsHub.Models
@using OpsHub.Services
@inject TicketService TicketsService
@inject SlaCalculator SlaCalculator
@inject NavigationManager Navigation

<PageTitle>@(ticket is null ? "Ticket | OpsHub" : $"Ticket #{ticket.Id} | OpsHub")</PageTitle>

<div class="details-page">
    <a class="back-link" href="/">← Back to service desk</a>

    @if (isLoading)
    {
        <p class="details-message">Loading ticket...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <section class="details-panel">
            <h1>Ticket unavailable</h1>
            <p>@errorMessage</p>
        </section>
    }
    else if (ticket is not null)
    {
        <header class="details-header">
            <div>
                <p class="details-eyebrow">SERVICE REQUEST · #@ticket.Id</p>
                <h1>@ticket.Title</h1>
                <p class="details-subtitle">Created @ticket.CreatedAtUtc.ToLocalTime().ToString("MMMM d, yyyy 'at' h:mm tt")</p>
            </div>
            <div class="details-actions">
                @if (ticket.IsArchived)
                {
                    <span class="archived-ticket-badge">Archived</span>
                }
                else
                {
                    <AuthorizeView Roles="Admin,Agent">
                        <Authorized Context="authState">
                            <a class="details-button details-secondary" href="@($"/?edit={ticket.Id}")">Edit ticket</a>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="Admin">
                        <Authorized Context="authState">
                            <button class="details-button details-danger" type="button"
                                    @onclick="() => confirmDelete = true">Archive</button>
                        </Authorized>
                    </AuthorizeView>
                }
            </div>
        </header>

        @if (confirmDelete)
        {
            <div class="delete-alert" role="alert">
                <span>Archive ticket #@ticket.Id? Its comments and history will be retained.</span>
                <button class="details-button details-danger" type="button"
                        @onclick="ArchiveTicketAsync" disabled="@isDeleting">
                    @(isDeleting ? "Archiving..." : "Confirm archive")
                </button>
                <button class="details-button details-secondary" type="button"
                        @onclick="() => confirmDelete = false">Cancel</button>
            </div>
        }

        <section class="ticket-status-strip" aria-label="Ticket status, priority, and SLA">
            <div>
                <span class="field-label">STATUS</span>
                <span class="@GetStatusClass(ticket.Status)">@ticket.Status</span>
            </div>
            <div>
                <span class="field-label">PRIORITY</span>
                <span class="@GetPriorityClass(ticket.Priority)">@ticket.Priority</span>
            </div>
            <div>
                <span class="field-label">CATEGORY</span>
                <strong>@ticket.Category</strong>
            </div>
            <div>
                <span class="field-label">DUE DATE</span>
                @if (ticket.DueAtUtc is DateTime dueDate)
                {
                    <strong class="@(IsOverdue ? "overdue" : "")">@dueDate.ToString("MMMM d, yyyy")</strong>
                }
                else
                {
                    <strong class="muted">Not scheduled</strong>
                }
            </div>
            <div>
                <span class="field-label">RESOLUTION SLA</span>
                <strong class="@GetSlaClass">@GetSlaLabel</strong>
                @if (ticket.SlaDueAtUtc is DateTime slaDeadline &&
                     ticket.Status != "Resolved")
                {
                    <small class="sla-deadline">Due @slaDeadline.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</small>
                }
            </div>
        </section>

        @if (IsOverdue)
        {
            <p class="overdue-banner" role="status">This ticket is overdue and still unresolved.</p>
        }

        <div class="details-grid">
            <section class="details-panel">
                <h2>Request details</h2>
                <dl>
                    <dt>Description</dt>
                    <dd class="description">@ticket.Description</dd>
                    <dt>Requester</dt>
                    <dd>@ticket.Requester</dd>
                    <dt>Assigned technician</dt>
                    <dd>@(string.IsNullOrWhiteSpace(ticket.AssignedTechnician) ? "Unassigned" : ticket.AssignedTechnician)</dd>
                    @if (ticket.Status == "Resolved" && !string.IsNullOrWhiteSpace(ticket.ResolutionNotes))
                    {
                        <dt>Resolution notes</dt>
                        <dd class="description">@ticket.ResolutionNotes</dd>
                    }
                </dl>
            </section>

            <aside class="details-panel activity-panel">
                <h2>Audit history</h2>
                <ol class="activity-list">
                    @foreach (var entry in auditHistory)
                    {
                        <li>
                            <span class="activity-dot @GetAuditDotClass(entry.EventType)"></span>
                            <div>
                                <strong>@entry.Description</strong>
                                <span class="audit-actor">
                                    @(entry.ActorId is null ? "Actor not recorded" : $"User ID: {entry.ActorId}")
                                </span>
                                <time datetime="@entry.OccurredAtUtc.ToString("O")">
                                    @entry.OccurredAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                </time>
                            </div>
                        </li>
                    }
                </ol>
                @if (auditHistory.Count == 0)
                {
                    <p class="empty-activity">No audit events have been recorded.</p>
                }
            </aside>
        </div>

        <section class="details-panel comments-panel">
            <div class="comments-heading">
                <div>
                    <h2>Comments</h2>
                    <p>Discussion and updates from the service desk.</p>
                </div>
                <span class="comment-count">@comments.Count</span>
            </div>

            @if (comments.Count == 0)
            {
                <p class="empty-activity">No comments yet. Add the first update below.</p>
            }
            else
            {
                <ol class="comment-list">
                    @foreach (var comment in comments)
                    {
                        <li @key="comment.Id">
                            <div class="comment-avatar" aria-hidden="true">•</div>
                            <div class="comment-body">
                                <div class="comment-meta">
                                    <strong>@(comment.ActorId is null ? "Comment" : $"User ID: {comment.ActorId}")</strong>
                                    <time datetime="@comment.CreatedAtUtc.ToString("O")">
                                        @comment.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                    </time>
                                </div>
                                <p>@comment.Content</p>
                            </div>
                        </li>
                    }
                </ol>
            }

            @if (ticket.IsArchived)
            {
                <p class="empty-activity">This ticket is archived. Comments are read-only.</p>
            }
            else
            {
                <EditForm Model="newComment" OnValidSubmit="AddCommentAsync" class="comment-form">
                    <DataAnnotationsValidator />
                    <label for="comment-content">Add a comment</label>
                    <InputTextArea id="comment-content" class="comment-input"
                                   @bind-Value="newComment.Content" maxlength="2000"
                                   rows="3" placeholder="Share an update or ask a question..." />
                    <ValidationMessage For="@(() => newComment.Content)" />
                    @if (!string.IsNullOrWhiteSpace(commentError))
                    {
                        <p class="comment-error" role="alert">@commentError</p>
                    }
                    <div class="comment-submit">
                        <span>Comments are separate from resolution notes and audit history.</span>
                        <button class="details-button details-primary" type="submit"
                                disabled="@isSubmittingComment">
                            @(isSubmittingComment ? "Posting..." : "Post comment")
                        </button>
                    </div>
                </EditForm>
            }
        </section>
    }
</div>

<style>
    .details-page { max-width: 1180px; margin: 0 auto; padding: 34px clamp(18px, 3vw, 42px); color: #17243a; }
    .back-link { display: inline-block; margin-bottom: 24px; color: #456aab; font-size: 12px; font-weight: 700; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .details-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
    .details-header h1 { margin: 0; font-size: clamp(24px, 3vw, 34px); letter-spacing: -.5px; }
    .details-eyebrow, .field-label { margin: 0 0 8px; color: #74839b; font-size: 10px; font-weight: 800; letter-spacing: 1.2px; }
    .details-subtitle { margin: 8px 0 0; color: #7e8ba0; font-size: 12px; }
    .details-actions { display: flex; gap: 8px; }
    .details-button { display: inline-block; border: 1px solid transparent; border-radius: 7px; padding: 9px 13px; font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; text-decoration: none; }
    .details-secondary { border-color: #dce2eb; background: #fff; color: #45536b; }
    .details-danger { border-color: #f0c4c0; background: #fff4f3; color: #a43e37; }
    .archived-ticket-badge { border-radius: 20px; padding: 6px 10px; background: #eef0f4; color: #6f7888; font-size: 10px; font-weight: 700; }
    .details-primary { background: #3867d6; color: white; }
    .details-primary:hover:not(:disabled) { background: #2e57bc; }
    .details-primary:disabled { opacity: .65; cursor: wait; }
    .ticket-status-strip, .details-panel { border: 1px solid #e7ebf2; border-radius: 11px; background: white; box-shadow: 0 2px 6px #14223a08; }
    .ticket-status-strip { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; padding: 18px; }
    .ticket-status-strip > div { display: flex; align-items: flex-start; flex-direction: column; gap: 7px; }
    .field-label { margin: 0; }
    .ticket-status-strip strong { color: #33425a; font-size: 12px; }
    .ticket-status-strip .sla-status { font-size: 11px; }
    .sla-deadline { color: #8793a6; font-size: 9px; }
    .sla-at-risk { color: #a4611b !important; }
    .sla-breached { color: #b7443c !important; }
    .sla-met { color: #347b5a !important; }
    .badge { display: inline-flex; border-radius: 20px; padding: 4px 8px; font-size: 10px; font-weight: 750; }
    .status-open { background: #fff2e5; color: #a4611b; }
    .status-progress { background: #e9f2ff; color: #3d6fab; }
    .status-resolved { background: #e8f7ef; color: #347b5a; }
    .priority-critical { background: #fff0ef; color: #b6423b; }
    .priority-high { background: #fff2e8; color: #a85b23; }
    .priority-medium { background: #fff8df; color: #876e1e; }
    .priority-low { background: #eff2f6; color: #657187; }
    .details-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, .8fr); gap: 16px; margin-top: 16px; }
    .details-panel { padding: 22px; }
    .details-panel h2 { margin: 0 0 20px; font-size: 16px; }
    dl { display: grid; grid-template-columns: minmax(140px, .4fr) minmax(0, 1fr); gap: 13px 18px; margin: 0; }
    dt { color: #78869b; font-size: 11px; font-weight: 700; }
    dd { margin: 0; color: #33425a; font-size: 12px; }
    .description { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.65; }
    .muted { color: #98a3b2 !important; }
    .overdue { color: #b7443c !important; }
    .overdue-banner, .delete-alert { display: flex; align-items: center; gap: 10px; margin: 12px 0 0; border: 1px solid #f0c4c0; border-radius: 8px; padding: 11px 13px; background: #fff4f3; color: #a43e37; font-size: 12px; }
    .delete-alert { justify-content: flex-end; flex-wrap: wrap; }
    .delete-alert span { margin-right: auto; }
    .activity-list { display: flex; flex-direction: column; gap: 20px; margin: 0; padding: 0; list-style: none; }
    .activity-list li { display: flex; align-items: flex-start; gap: 10px; }
    .activity-dot { width: 9px; height: 9px; flex: 0 0 auto; margin-top: 4px; border: 2px solid #6f9be2; border-radius: 50%; background: #eaf2ff; }
    .activity-updated { border-color: #58a67e; background: #e8f7ef; }
    .activity-list strong, .activity-list time { display: block; }
    .activity-list strong { color: #40516a; font-size: 11px; }
    .activity-list time { margin-top: 4px; color: #8491a4; font-size: 10px; }
    .audit-actor { display: block; margin-top: 4px; color: #8995a8; font-size: 9px; }
    .empty-activity { color: #8995a8; font-size: 11px; }
    .comments-panel { margin-top: 16px; }
    .comments-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
    .comments-heading h2 { margin: 0; font-size: 16px; }
    .comments-heading p { margin: 6px 0 0; color: #7e8ba0; font-size: 11px; }
    .comment-count { border-radius: 20px; padding: 5px 9px; background: #eff3fa; color: #60718b; font-size: 10px; font-weight: 700; }
    .comment-list { display: flex; flex-direction: column; gap: 16px; margin: 0; padding: 0; list-style: none; }
    .comment-list li { display: flex; align-items: flex-start; gap: 11px; }
    .comment-avatar { display: grid; width: 30px; height: 30px; flex: 0 0 auto; place-items: center; border-radius: 50%; background: #edf2fb; color: #5d7bb5; font-size: 18px; }
    .comment-body { min-width: 0; flex: 1; border: 1px solid #edf0f5; border-radius: 8px; padding: 11px 13px; }
    .comment-meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .comment-meta strong { color: #40516a; font-size: 10px; }
    .comment-meta time { color: #8995a8; font-size: 9px; }
    .comment-body p { margin: 8px 0 0; color: #4a5870; font-size: 11px; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
    .comment-form { display: flex; flex-direction: column; gap: 8px; margin-top: 20px; border-top: 1px solid #edf0f5; padding-top: 17px; }
    .comment-form label { color: #495970; font-size: 11px; font-weight: 700; }
    .comment-input { box-sizing: border-box; width: 100%; resize: vertical; border: 1px solid #dce2eb; border-radius: 7px; padding: 10px 11px; color: #17243a; font: inherit; font-size: 11px; }
    .comment-input:focus { outline: 3px solid #d6e3ff; border-color: #7d9de2; }
    .comment-submit { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .comment-submit > span { color: #8995a8; font-size: 9px; }
    .comment-error { margin: 0; color: #a43e37; font-size: 10px; }
    .details-message { padding: 60px 10px; color: #738198; text-align: center; }
    @@media (max-width: 720px) {
        .details-page { padding: 22px 14px; }
        .details-header { flex-direction: column; }
        .ticket-status-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .details-grid { grid-template-columns: 1fr; }
        .details-panel { padding: 17px; }
        dl { grid-template-columns: 1fr; gap: 6px; }
        dd + dt { margin-top: 8px; }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private SupportTicket? ticket;
    private bool isLoading = true;
    private bool confirmDelete;
    private bool isDeleting;
    private bool isSubmittingComment;
    private List<TicketComment> comments = [];
    private List<TicketAuditEvent> auditHistory = [];
    private TicketComment newComment = new();
    private string commentError = "";
    private string errorMessage = "";
    private bool IsOverdue => ticket is not null &&
        !ticket.IsArchived &&
        ticket.Status != "Resolved" &&
        ticket.DueAtUtc is DateTime due && due.Date < DateTime.UtcNow.Date;
    private string GetSlaLabel => ticket is null
        ? "Not tracked"
        : SlaCalculator.Assess(ticket, DateTime.UtcNow).State switch
        {
            SlaState.OnTrack => $"{FormatRemaining(SlaCalculator.Assess(ticket, DateTime.UtcNow).Remaining)} remaining",
            SlaState.AtRisk => $"At risk · {FormatRemaining(SlaCalculator.Assess(ticket, DateTime.UtcNow).Remaining)}",
            SlaState.Breached => "SLA breached",
            SlaState.Met => "SLA met",
            _ => "Not tracked"
        };
    private string GetSlaClass => ticket is null
        ? "sla-status"
        : "sla-status " + (SlaCalculator.Assess(ticket, DateTime.UtcNow).State switch
        {
            SlaState.AtRisk => "sla-at-risk",
            SlaState.Breached => "sla-breached",
            SlaState.Met => "sla-met",
            _ => ""
        });

    private static string FormatRemaining(TimeSpan? remaining)
    {
        if (remaining is null || remaining <= TimeSpan.Zero)
            return "0h";
        var value = remaining.Value;
        return value.TotalDays >= 1
            ? $"{(int)value.TotalDays}d {value.Hours}h"
            : $"{(int)value.TotalHours}h {value.Minutes}m";
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            ticket = await TicketsService.GetByIdAsync(Id);
            if (ticket is null)
                errorMessage = $"Ticket #{Id} was not found.";
            else
            {
                var commentsTask = TicketsService.GetCommentsAsync(Id);
                var historyTask = TicketsService.GetAuditHistoryAsync(Id);
                await Task.WhenAll(commentsTask, historyTask);
                comments = (await commentsTask).ToList();
                auditHistory = (await historyTask).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not load ticket #{Id}: {ex}");
            errorMessage = "Could not load this ticket. Check the application logs.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddCommentAsync()
    {
        if (isSubmittingComment)
            return;

        isSubmittingComment = true;
        commentError = "";
        try
        {
            await TicketsService.AddCommentAsync(Id, newComment.Content);
            comments = (await TicketsService.GetCommentsAsync(Id)).ToList();
            newComment = new TicketComment();
        }
        catch (ArgumentException ex)
        {
            commentError = ex.Message;
        }
        catch (KeyNotFoundException ex)
        {
            commentError = ex.Message;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not add comment to ticket #{Id}: {ex}");
            commentError = "Could not post the comment. Check the application logs.";
        }
        finally
        {
            isSubmittingComment = false;
        }
    }

    private async Task ArchiveTicketAsync()
    {
        if (isDeleting)
            return;

        isDeleting = true;
        try
        {
            await TicketsService.ArchiveAsync(Id);
            Navigation.NavigateTo("/");
        }
        catch (KeyNotFoundException)
        {
            errorMessage = $"Ticket #{Id} no longer exists.";
            ticket = null;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not archive ticket #{Id}: {ex}");
            errorMessage = "Could not archive this ticket. Check the application logs.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private static string GetStatusClass(string status) => status switch
    {
        "Open" => "badge status-open",
        "In Progress" => "badge status-progress",
        "Resolved" => "badge status-resolved",
        _ => "badge"
    };

    private static string GetPriorityClass(string priority) => priority switch
    {
        "Critical" => "badge priority-critical",
        "High" => "badge priority-high",
        "Medium" => "badge priority-medium",
        "Low" => "badge priority-low",
        _ => "badge"
    };

    private static string GetAuditDotClass(string eventType) => eventType switch
    {
        "TicketCreated" => "",
        "StatusChanged" => "activity-updated",
        "ResolutionChanged" => "activity-updated",
        _ => "activity-neutral"
    };
}
