<div class="brand-row">
    <a class="brand-link" href="/">
        <span class="brand-mark" aria-hidden="true">O</span>
        <span>
            <strong>OpsHub</strong>
            <small>IT SERVICE DESK</small>
        </span>
    </a>
</div>

<div class="workspace-label">WORKSPACE</div>

<nav class="nav-menu" aria-label="Main navigation">
    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
        <span class="nav-icon" aria-hidden="true">▦</span>
        <span>Overview</span>
    </NavLink>
    <a class="nav-link" href="/#ticket-list">
        <span class="nav-icon" aria-hidden="true">▤</span>
        <span>Tickets</span>
    </a>
    <NavLink class="nav-link" href="/analytics">
        <span class="nav-icon" aria-hidden="true">◫</span>
        <span>Analytics</span>
    </NavLink>
    <AuthorizeView Roles="Admin">
        <NavLink class="nav-link" href="/admin/users">
            <span class="nav-icon" aria-hidden="true">♙</span>
            <span>User administration</span>
        </NavLink>
    </AuthorizeView>
</nav>

<div class="account-row">
    <AuthorizeView>
        <Authorized Context="authState">
            <div class="account-identity">
                <strong>@authState.User.Identity?.Name</strong>
                <small>Signed in</small>
            </div>
            <form action="/account/logout" method="post">
                <AntiforgeryToken />
                <button class="sign-out-button" type="submit">Sign out</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a class="sign-in-link" href="/account/login">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="sidebar-footer">
    <span class="database-icon" aria-hidden="true">▣</span>
    <span>Secure service desk</span>
</div>
